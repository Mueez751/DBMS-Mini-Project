# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
# Nothing in the source code contains credentials; everything comes from here.

# PostgreSQL: connect as the restricted role created by database/06_app_security.sql
# (airfare_app), NOT as a superuser or the table owner. Use the same password you passed
# to 06_app_security.sql as app_password.
# If the password contains special characters, URL-encode them (@ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL=postgresql://airfare_app:CHANGE_ME@localhost:5432/airfare
# Set to true when the database requires TLS (managed/cloud databases)
PGSSL=false

# MongoDB: raw Amadeus payloads (collection raw_fare_payloads, see database/05_mongo_setup.js)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=airfare

# Signs the login cookie. Must be at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Cookies are marked Secure in production builds. Set to false ONLY when running a production
# build (npm run build && npm start) over plain http://localhost. `npm run dev` does not need it.
COOKIE_SECURE=false

# Shows the demo logins on the sign-in page. Coursework demo only: set to false in any real deployment.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
